{"id": "conviction", "kind": "development", "question": "How could curiosity help a founder build conviction about a difficult, high-risk company decision?", "condition": "graph", "top_three": ["jensen-lex-494-02", "jensen-acquired-2023-01"], "annotated_sources": [{"tag": "L1", "id": "jensen-lex-494-02", "url": "https://lexfridman.com/jensen-huang-transcript/", "locator": "Transcript question and answer blocks 00:16:45 → 00:17:14"}, {"tag": "A1", "id": "jensen-acquired-2023-01", "url": "https://www.acquired.fm/episodes/jensen-huang#transcript", "locator": "Ben, when you have conviction"}], "available_tags": ["L1", "A1"], "triples": 5, "facts_sha256": "ea4449e7cc382626f81ecd4ea461887a016c39689c8f12f83091a25aaef6db44", "answer": "Curiosity helped a founder reason through the future of their decision, building conviction and sustaining persistence through the difficulty. [L1]", "prompt_tokens": 244, "output_tokens": 27, "finish_reason": "stop", "seconds": 7.08, "runtime": "b12318-7021f7e09", "prompt_sha256": "51ccc4b35d982c67b34b676becd269cd86c2c67dfccf4b560946d8d0fbe7f4f1", "cited": ["L1"], "out_of_packet": [], "expected_citation": true}
{"id": "conviction", "kind": "development", "question": "How could curiosity help a founder build conviction about a difficult, high-risk company decision?", "condition": "flat", "top_three": ["jensen-lex-494-02", "jensen-acquired-2023-01"], "annotated_sources": [{"tag": "L1", "id": "jensen-lex-494-02", "url": "https://lexfridman.com/jensen-huang-transcript/", "locator": "Transcript question and answer blocks 00:16:45 → 00:17:14"}, {"tag": "A1", "id": "jensen-acquired-2023-01", "url": "https://www.acquired.fm/episodes/jensen-huang#transcript", "locator": "Ben, when you have conviction"}], "available_tags": ["L1", "A1"], "triples": 5, "facts_sha256": "ea4449e7cc382626f81ecd4ea461887a016c39689c8f12f83091a25aaef6db44", "answer": "Curiosity about the potential future of a decision can lead to reasoned understanding, which in turn builds conviction. This conviction then sustains perseverance through the challenges, even when the outcome is uncertain. Emulating a product and testing its software before committing to a company can reduce uncertainty, making the commitment a more informed and less risky decision.", "prompt_tokens": 219, "output_tokens": 67, "finish_reason": "stop", "seconds": 10.278, "runtime": "b12318-7021f7e09", "prompt_sha256": "4c4fcab7da9b8e0c114999dde14f420a5bd64ec50e30ba892c6681f0ebc906a1", "cited": [], "out_of_packet": [], "expected_citation": false}
