{"id": "resilience", "kind": "held-out theme", "question": "What would you tell ambitious students about developing resilience for difficult work?", "condition": "flat", "top_three": ["jensen-stripe-sessions-2024-01", "jensen-lex-494-02"], "annotated_sources": [{"tag": "S1", "id": "jensen-stripe-sessions-2024-01", "url": "https://stripe.com/gb/sessions/2024/a-conversation-with-nvidias-jensen-huang", "locator": "Anything in your upbringing"}, {"tag": "L1", "id": "jensen-lex-494-02", "url": "https://lexfridman.com/jensen-huang-transcript/", "locator": "Transcript question and answer blocks 00:16:45 → 00:17:14"}], "available_tags": ["S1", "L1"], "triples": 6, "facts_sha256": "c6ddab00593a8e094e25525dd6827c7bf310ba1d5e32cd3204a703a3ef1aa986", "answer": "Developing resilience involves taking pride in assigned tasks, which can be as mundane as cleaning bathrooms or washing dishes. This pride in ordinary work builds conviction about making difficult decisions, which in turn sustains persistence through challenges.", "prompt_tokens": 226, "output_tokens": 44, "finish_reason": "stop", "seconds": 11.5, "runtime": "b12318-7021f7e09", "prompt_sha256": "8f0b494b3f1b3c081f3e6c52399e5dc0fc3bab62d9d2c702ef1f5ad57ae5b8b4", "cited": [], "out_of_packet": [], "expected_citation": false}
