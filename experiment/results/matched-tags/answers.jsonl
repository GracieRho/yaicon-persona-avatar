{"id": "work", "kind": "development", "question": "What can a student assigned an unnoticed restaurant job learn from your boarding school chores and early work?", "condition": "flat", "top_three": ["jensen-stripe-sessions-2024-01"], "annotated_sources": [{"tag": "S1", "id": "jensen-stripe-sessions-2024-01", "url": "https://stripe.com/gb/sessions/2024/a-conversation-with-nvidias-jensen-huang", "locator": "Anything in your upbringing"}], "available_tags": ["S1"], "triples": 3, "facts_sha256": "536830241839b8a32e6edd1addd2b8d0eead800ef632e5abbd32cb79f866f510", "answer": "A student assigned an unnoticed restaurant job can learn the value of taking pride in an assigned task, as demonstrated by cleaning bathrooms and washing dishes, which are considered ordinary jobs. This experience underscores the importance of doing even the simplest tasks well.", "prompt_tokens": 177, "output_tokens": 48, "finish_reason": "stop", "seconds": 20.532, "runtime": "b12318-7021f7e09", "prompt_sha256": "35f2c0705014d94f1fd275168edd3b4a03bc9d4f21c86191155294ca4f1208d5", "cited": [], "out_of_packet": [], "expected_citation": false}
{"id": "work", "kind": "development", "question": "What can a student assigned an unnoticed restaurant job learn from your boarding school chores and early work?", "condition": "graph", "top_three": ["jensen-stripe-sessions-2024-01"], "annotated_sources": [{"tag": "S1", "id": "jensen-stripe-sessions-2024-01", "url": "https://stripe.com/gb/sessions/2024/a-conversation-with-nvidias-jensen-huang", "locator": "Anything in your upbringing"}], "available_tags": ["S1"], "triples": 3, "facts_sha256": "536830241839b8a32e6edd1addd2b8d0eead800ef632e5abbd32cb79f866f510", "answer": "A student assigned an unnoticed restaurant job can learn to take pride in an assigned task and to do even ordinary work as well as one can, as illustrated by the boarding school chores and early work. [S1]", "prompt_tokens": 189, "output_tokens": 44, "finish_reason": "stop", "seconds": 19.514, "runtime": "b12318-7021f7e09", "prompt_sha256": "973b229105afdb64934f5b64ae91a890423bb00d73dd8fe1b37239f4edebdbf0", "cited": ["S1"], "out_of_packet": [], "expected_citation": true}
